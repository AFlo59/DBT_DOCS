# =============================================================================
# Variables d'environnement pour DBT Template
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copier ce fichier vers .env : copy env.exemple .env
# 2. Remplir les valeurs avec vos credentials réels
# 3. Charger les variables avant d'exécuter DBT
# 4. Ne JAMAIS versionner le fichier .env !
#
# =============================================================================

# =============================================================================
# ENVIRONNEMENT DBT
# =============================================================================

# Target par défaut (dev, rec, ou prod)
DBT_TARGET=dev

# =============================================================================
# SNOWFLAKE - CONNEXION GÉNÉRALE
# =============================================================================

# Identifiant du compte Snowflake (ex: xy12345.eu-west-1)
DBT_SNOWFLAKE_ACCOUNT=

# Utilisateur Snowflake
DBT_SNOWFLAKE_USER=

# Mot de passe Snowflake
DBT_SNOWFLAKE_PASSWORD=

# =============================================================================
# SNOWFLAKE - CONFIGURATION DEV/REC
# =============================================================================

# Rôle Snowflake (défaut: DEVELOPER pour dev, TRANSFORMER pour rec/prod)
DBT_SNOWFLAKE_ROLE=DEVELOPER

# Warehouse Snowflake
DBT_SNOWFLAKE_WAREHOUSE=DEV_WH

# Database Snowflake
DBT_SNOWFLAKE_DATABASE=DEV_DB

# =============================================================================
# SNOWFLAKE - CONFIGURATION PRODUCTION (optionnel)
# =============================================================================
# Si vos credentials production sont différents de dev, définissez-les ici.
# Sinon, les valeurs ci-dessus seront utilisées.

# DBT_SNOWFLAKE_PROD_USER=
# DBT_SNOWFLAKE_PROD_PASSWORD=
# DBT_SNOWFLAKE_PROD_ROLE=TRANSFORMER
# DBT_SNOWFLAKE_PROD_WAREHOUSE=PROD_WH
# DBT_SNOWFLAKE_PROD_DATABASE=PROD_DB

# =============================================================================
# CHARGEMENT DES VARIABLES
# =============================================================================
#
# Windows PowerShell:
# -------------------
# Get-Content .env | ForEach-Object {
#     if ($_ -match '^([^#][^=]*)=(.*)$') {
#         [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim())
#     }
# }
#
# macOS / Linux:
# --------------
# set -a && source .env && set +a
#
# Ou avec export (ajouter 'export ' devant chaque variable):
# source .env
#
# =============================================================================

# =============================================================================
# VARIABLES UTILISÉES DANS LE PROJET
# =============================================================================
#
# profiles.exemple.yml:
#   - DBT_TARGET              → Target par défaut
#   - DBT_SNOWFLAKE_ACCOUNT   → Compte Snowflake
#   - DBT_SNOWFLAKE_USER      → Utilisateur
#   - DBT_SNOWFLAKE_PASSWORD  → Mot de passe
#   - DBT_SNOWFLAKE_ROLE      → Rôle (avec défauts)
#   - DBT_SNOWFLAKE_WAREHOUSE → Warehouse (avec défauts)
#   - DBT_SNOWFLAKE_DATABASE  → Database (avec défauts)
#   - USER ou USERNAME        → Pour le schéma dynamique en dev
#
# dbt_project.yml:
#   - DBT_TARGET              → Variable 'environment'
#
# =============================================================================

